# =====================================================================
#  CS2 Panel — files that must never be committed
# =====================================================================

# ---- Local configuration & secrets ----------------------------------
config/config.php
config/*.local.php
.env
.env.*
!.env.example
*.pem
*.key

# ---- Local development ---------------------------------------------
.dev/
_devrouter.php

# ---- Runtime data written by the panel ------------------------------
error.log
*.log
.avatar_cache.json
.update_cache.json
.update_tmp/
.maintenance
storage/*
!storage/.htaccess

# Database backups, update rollback snapshots and chunked update jobs
db_backups/*
!db_backups/.gitkeep
!db_backups/.htaccess

# User uploads (logos, images uploaded from Settings)
assets/img/uploads/*
!assets/img/uploads/.gitkeep

# ---- Dependencies & build output ------------------------------------
node_modules/
vendor/
!assets/vendor/
dist/
release/
*.zip
*.tar
*.tar.gz
*.tgz

# Generated by tools/convert-webp.php (regenerated on the server)
assets/img/**/*.webp

# ---- Archives / dumps ------------------------------------------------
*.sql.gz
*.dump
/*.sql

# ---- Editors & IDEs -------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.fleet/
.history/
*.swp
*.swo
*~

# ---- PHP tooling caches ---------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.php_cs.cache
.phpstan/
.psalm/
composer.phar

# ---- Node tooling ---------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache

# ---- OS files -------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Temporary files ------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
tmp/
temp/
